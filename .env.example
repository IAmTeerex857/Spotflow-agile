# Supabase project settings (Project Settings > API). Both are safe to expose
# in the browser; access is enforced by the database functions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional, dev only: extra origins allowed to load the dev server.
# DEV_ORIGINS=192.168.1.20

# CLI only, never exposed to the browser: used to push the database migrations.
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# SUPABASE_DB_PASSWORD=

# Optional: the public address, used for link previews. Defaults to https://agile.spotflow.one
# NEXT_PUBLIC_SITE_URL=https://agile.spotflow.one
